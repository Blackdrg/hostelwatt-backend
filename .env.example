# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If local MongoDB is not running, backend will automatically use an in-memory MongoDB fallback
MONGODB_URI=mongodb://127.0.0.1:27017/hostelwatt

# JWT Secret
JWT_SECRET=hostelwatt_super_secret_jwt_key_2026_smart_energy
JWT_EXPIRES_IN=7d

# MQTT Configuration
# HostelWatt includes a built-in Aedes MQTT broker on MQTT_PORT (default 1883)
MQTT_PORT=1883
# MQTT Broker URL that the backend and ESP32/simulator connect to
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
ENABLE_EMBEDDED_MQTT=true

# Energy & Tariff Defaults
DEFAULT_TARIFF_PER_KWH=8.50
FIXED_CHARGE_PER_MONTH=50.00
CURRENCY=INR
CURRENCY_SYMBOL=₹
ABNORMAL_POWER_THRESHOLD_KW=3.5
VACANT_POWER_THRESHOLD_KW=0.15
